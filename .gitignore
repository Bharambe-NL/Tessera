# rust
/target/
**/target/
Cargo.lock.bak

# node
node_modules/
dist/
.vite/
*.tsbuildinfo

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# generated corpora, reproducible from a seed. `gen build` defaults to
# `synthetic/` at the repo root, which the two paths below never covered: a
# 5.6 MB tree of generated documents was one `git add .` away from the history.
/synthetic/
/gen/synthetic/
/eval/synthetic/

# Mock eval output is reproducible and disposable. A sweep against a live
# provider is neither: it cost money, it cannot be reproduced exactly, and it is
# the record of what the product scored on the day. Those are kept.
/eval/results/*/mock/
# The grounded sweep run under `--policy ci` is the per step gate, and the same
# reasoning applies to it: 8.6 MB of run rows, reproducible from the seed by one
# free command, and uploaded as a CI artifact where a failure needs reading. The
# `grounded/` records already in the history stay, because BUILD_NOTES entries
# cite them by path.
/eval/results/*/ci/
# Retrieval probe output: large, and regenerated by one free command.
/eval/results/retrieval/

# local profile data, never committed
*.sqlite
*.sqlite-wal
*.sqlite-shm
/blobs/

# os
.DS_Store
Thumbs.db
desktop.ini

# secrets never land in a file; this is a belt and braces guard
.env
.env.*
!.env.example

# gate output, regenerated by running the gate
/eval/gate/

# Playwright output: traces, screenshots and videos of one run, regenerated by
# `pnpm --dir app/ui e2e`.
/app/ui/test-results/
/app/ui/playwright-report/
/app/ui/.playwright/

# the generator's venv
/gen/.venv/
*.egg-info/

# Never commit a key file. Keys belong in the OS keychain; see tessera-keys.
Keys.txt
keys.txt
*.key
*secret*
