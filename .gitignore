# rust
/target/
**/target/
Cargo.lock.bak

# node
node_modules/
dist/
.vite/
*.tsbuildinfo

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# generated corpora, reproducible from a seed
/gen/synthetic/
/eval/synthetic/

# Mock eval output is reproducible and disposable. A sweep against a live
# provider is neither: it cost money, it cannot be reproduced exactly, and it is
# the record of what the product scored on the day. Those are kept.
/eval/results/*/mock/
# Retrieval probe output: large, and regenerated by one free command.
/eval/results/retrieval/

# local profile data, never committed
*.sqlite
*.sqlite-wal
*.sqlite-shm
/blobs/

# os
.DS_Store
Thumbs.db
desktop.ini

# secrets never land in a file; this is a belt and braces guard
.env
.env.*
!.env.example

# gate output, regenerated by running the gate
/eval/gate/

# the generator's venv
/gen/.venv/
*.egg-info/

# Never commit a key file. Keys belong in the OS keychain; see tessera-keys.
Keys.txt
keys.txt
*.key
*secret*
