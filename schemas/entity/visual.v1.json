{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera:entity/visual.v1",
  "title": "Visual",
  "description": "Doc 01 sections 4.3 and 4.3.1. Stored separately from Card so a Visual can be revised without a Card rerun, and so the Exercise agent can read it without loading prose.",
  "type": "object",
  "required": [
    "type",
    "title",
    "payload",
    "block_index"
  ],
  "properties": {
    "id": {
      "$ref": "tessera:entity/common.v1#/$defs/ulid"
    },
    "card_id": {
      "$ref": "tessera:entity/common.v1#/$defs/ulid"
    },
    "type": {
      "$ref": "tessera:entity/common.v1#/$defs/visual_type"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "block_index": {
      "type": "array",
      "description": "Every clickable block, its path, and which citations support it. Built by the Visualizer, checked by the Verifier.",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "supersedes": {
      "oneOf": [
        {
          "$ref": "tessera:entity/common.v1#/$defs/ulid"
        },
        {
          "type": "null"
        }
      ]
    },
    "produced_by": {
      "$ref": "tessera:entity/common.v1#/$defs/produced_by"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "tree"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/tree"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "table"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/table"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "list"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/list"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "steps"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/steps"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "figure"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/figure"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "image"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/image"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "chart"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/chart"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "widget"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/widget"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "flow"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/flow"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "stats"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/stats"
          }
        }
      }
    }
  ],
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "ref",
        "label"
      ],
      "properties": {
        "ref": {
          "$ref": "tessera:entity/common.v1#/$defs/block_ref"
        },
        "label": {
          "type": "string"
        },
        "citation_ordinals": {
          "$ref": "tessera:entity/common.v1#/$defs/citation_ordinals"
        },
        "no_claim": {
          "type": "boolean",
          "description": "Doc 07 section B8.3 limits this to structural labels: a group heading, a column name."
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "citation_ordinals": {
          "$ref": "tessera:entity/common.v1#/$defs/citation_ordinals"
        },
        "children": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/node_l1"
          }
        }
      }
    },
    "node_l1": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "citation_ordinals": {
          "$ref": "tessera:entity/common.v1#/$defs/citation_ordinals"
        },
        "children": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/node_l2"
          }
        }
      }
    },
    "node_l2": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "citation_ordinals": {
          "$ref": "tessera:entity/common.v1#/$defs/citation_ordinals"
        },
        "children": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/node_l3"
          }
        }
      }
    },
    "node_l3": {
      "type": "object",
      "required": [
        "label"
      ],
      "description": "Depth at most 3 below root, so this level carries no children. Doc 01 section 4.3.1.",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "citation_ordinals": {
          "$ref": "tessera:entity/common.v1#/$defs/citation_ordinals"
        }
      },
      "not": {
        "required": [
          "children"
        ]
      }
    },
    "bottom_line": {
      "type": "object",
      "required": [
        "head",
        "text"
      ],
      "properties": {
        "head": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "citation_ordinals": {
          "$ref": "tessera:entity/common.v1#/$defs/citation_ordinals"
        }
      }
    },
    "tree": {
      "type": "object",
      "required": [
        "root"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "$ref": "#/$defs/node"
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "columns",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "bottom_line": {
          "$ref": "#/$defs/bottom_line"
        }
      }
    },
    "list": {
      "type": "object",
      "required": [
        "groups"
      ],
      "additionalProperties": false,
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "heading",
              "items"
            ],
            "properties": {
              "heading": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "citation_ordinals": {
                      "$ref": "tessera:entity/common.v1#/$defs/citation_ordinals"
                    }
                  }
                }
              }
            }
          }
        },
        "bottom_line": {
          "$ref": "#/$defs/bottom_line"
        }
      }
    },
    "steps": {
      "type": "object",
      "required": [
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "citation_ordinals": {
                "$ref": "tessera:entity/common.v1#/$defs/citation_ordinals"
              }
            }
          }
        },
        "bottom_line": {
          "$ref": "#/$defs/bottom_line"
        }
      }
    },
    "figure": {
      "type": "object",
      "required": [
        "svg"
      ],
      "additionalProperties": false,
      "description": "The svg is sanitised by the harness before storage: no script, no foreignObject, no external references. Sanitisation is a Step with its own event.",
      "properties": {
        "svg": {
          "type": "string",
          "pattern": "^\\s*<svg"
        },
        "caption": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "image_id"
      ],
      "additionalProperties": false,
      "description": "Generated images reference an Image row so they get the same treatment as pasted ones.",
      "properties": {
        "image_id": {
          "$ref": "tessera:entity/common.v1#/$defs/ulid"
        },
        "caption": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        }
      }
    },
    "chart": {
      "type": "object",
      "description": "Reserved for v1.1. Doc 01 section 9: every point cites a passage or a structured query step, and the Visualizer may never invent a point.",
      "required": [
        "kind",
        "series"
      ],
      "properties": {
        "kind": {
          "enum": [
            "bar",
            "line",
            "area"
          ]
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "points"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "citation_ordinals"
                  ],
                  "properties": {
                    "x": {},
                    "y": {},
                    "citation_ordinals": {
                      "$ref": "tessera:entity/common.v1#/$defs/citation_ordinals",
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        },
        "unit": {
          "type": "string"
        },
        "source_query_step_id": {
          "$ref": "tessera:entity/common.v1#/$defs/ulid"
        }
      }
    },
    "widget": {
      "type": "object",
      "description": "Reserved for v1.1. Rendered in a sandboxed iframe with a message bridge; the Verifier checks the html against an allowlist before storage.",
      "required": [
        "html",
        "sandbox_policy"
      ],
      "properties": {
        "html": {
          "type": "string"
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "binds_to"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "toggle",
                  "slider",
                  "region"
                ]
              },
              "binds_to": {
                "$ref": "tessera:entity/common.v1#/$defs/block_ref"
              }
            }
          }
        },
        "sandbox_policy": {
          "type": "string"
        }
      }
    },
    "flow": {
      "type": "object",
      "description": "Doc 16 section 3.5. Nodes and the edges between them, which a tree cannot express: a tree has no cycles and no cross links, and a flow is where the answer has one.",
      "required": [
        "nodes"
      ],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              },
              "citation_ordinals": {
                "$ref": "tessera:entity/common.v1#/$defs/citation_ordinals"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "description": "Both ends name a node id. An edge to a node that is not there is dropped by the Visualizer rather than stored.",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "bottom_line": {
          "$ref": "#/$defs/bottom_line"
        }
      }
    },
    "stats": {
      "type": "object",
      "description": "Doc 16 section 3.5. At most six large numerals, every one of them cited: a tile is a figure with nothing around it to qualify it, so a tile without a citation is a numeric_without_citation block flag.",
      "required": [
        "tiles"
      ],
      "additionalProperties": false,
      "properties": {
        "tiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "citation_ordinals": {
                "$ref": "tessera:entity/common.v1#/$defs/citation_ordinals"
              }
            }
          }
        },
        "bottom_line": {
          "$ref": "#/$defs/bottom_line"
        }
      }
    }
  }
}
