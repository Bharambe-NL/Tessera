{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera:pack/doctrine-pack.v1",
  "title": "Doctrine pack",
  "description": "Doc 01 section 4.17. Doctrine is data: packs are files, versioned, importable, editable in the Profile, and no pack content lives in code (doc 10 principle 6). A board pins a version, and a pack update never rewrites it.",
  "type": "object",
  "required": [
    "code",
    "version",
    "audiences",
    "source_hierarchy",
    "freshness_classes",
    "flag_rules",
    "retrievers",
    "exercise_templates"
  ],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "examples": [
        "general",
        "finance-eu"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semver. Boards pin a version."
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The Router classifies into one of these or unknown."
    },
    "domain_vocabulary": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "Keywords per domain. A strong single match sets the domain without asking the model (doc 03 section 8.1)."
    },
    "depth_hints": {
      "type": "object",
      "description": "Retired on 2026-08-30. Packs no longer influence depth; the Router decides from its own classification. Accepted so packs written earlier still import, and ignored."
    },
    "minimum_depth": {
      "type": "object",
      "description": "Retired on 2026-08-30 with depth_hints. Accepted so packs written earlier still import, and ignored."
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "vocabulary_notes": {
            "type": "string"
          },
          "avoid": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Terms the audience_vocabulary model check flags. Doc 07 section B8.5."
          }
        }
      }
    },
    "source_hierarchy": {
      "type": "array",
      "description": "Which sources outrank which. Finance: regulator over filing over press. Lower trust_rank is more trusted.",
      "items": {
        "type": "object",
        "required": [
          "class",
          "trust_rank"
        ],
        "properties": {
          "class": {
            "$ref": "tessera:entity/common.v1#/$defs/source_class"
          },
          "issuer_pattern": {
            "type": "string"
          },
          "trust_rank": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "freshness_classes": {
      "type": "object",
      "description": "Regulation ages differently from a product doc. Drives the freshness gate, Pattern 5.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "max_age_days",
          "on_stale"
        ],
        "properties": {
          "max_age_days": {
            "type": "integer",
            "minimum": 1
          },
          "on_stale": {
            "enum": [
              "flag",
              "rerun"
            ]
          }
        }
      }
    },
    "flag_rules": {
      "type": "array",
      "description": "What the Verifier must hold back. Doc 07 section B8. A rule whose false positive rate exceeds 0.10 is disabled by default and listed as an open item (doc 02 section 10.3).",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "description",
          "detector"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "severity": {
            "$ref": "tessera:entity/common.v1#/$defs/severity"
          },
          "description": {
            "type": "string"
          },
          "detector": {
            "type": "string",
            "pattern": "^(deterministic|model):[a-z0-9_]+$",
            "description": "Names a deterministic check or a model prompt id. A model detector may raise at most warn (doc 07 section B8.5)."
          },
          "params": {
            "type": "object"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "modes": {
            "type": "array",
            "items": {
              "$ref": "tessera:entity/common.v1#/$defs/depth"
            },
            "description": "Modes the rule runs in. Absent means every mode."
          }
        }
      }
    },
    "sensitivity_rules": {
      "type": "array",
      "description": "Run by the Router before any retrieval spends money. Doc 03 section 8.4.",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "detector",
          "severity"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "detector": {
            "type": "string"
          },
          "severity": {
            "$ref": "tessera:entity/common.v1#/$defs/severity"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "retrievers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "enum": [
              "web",
              "local",
              "regulatory",
              "structured",
              "vault",
              "boards"
            ]
          },
          "enabled_by_default": {
            "type": "boolean"
          },
          "config": {
            "type": "object"
          },
          "must_exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The Planner may add to this, never remove from it. Doc 04 section 5."
          }
        }
      }
    },
    "visual_preferences": {
      "type": "object",
      "properties": {
        "type_preferences": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1
        },
        "generated_images": {
          "type": "boolean",
          "description": "Doc 06 section B14 open question 2, resolved as proposed: on for the general pack, off for finance."
        }
      }
    },
    "writing_rules": {
      "type": "object",
      "properties": {
        "units": {
          "type": "string"
        },
        "spelling": {
          "type": "string"
        },
        "sentence_max_words": {
          "type": "integer",
          "minimum": 1
        },
        "dashes": {
          "type": "boolean"
        }
      }
    },
    "exercise_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "item_kinds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "item_kinds": {
            "type": "array",
            "items": {
              "enum": [
                "recall",
                "apply",
                "contrast",
                "trace"
              ]
            }
          },
          "items_per_card_max": {
            "type": "integer",
            "minimum": 1
          },
          "options": {
            "type": "integer",
            "minimum": 2
          }
        }
      }
    },
    "learning_templates": {
      "type": "object",
      "description": "Doc 14 section 3.2 and doc 17 section 8: the shapes a curriculum takes, how many correct checks count as mastery, the intake questions a domain asks, and what the learning system needs to decide a concept is learned rather than seen. Doctrine rather than substrate, so a pack decides them and no code does.",
      "properties": {
        "curriculum_shapes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mastery_threshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Doc 14 section 3.6: how many correct checks in a session make a concept mastered. A count, and distinct from `mastered_at`, which is a score on the concept row itself."
        },
        "intake_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mastered_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Doc 17 section 2.3: `mastered` means mastery at or above the doctrine threshold, default 0.8. A score between 0 and 1 on the concept, which is why it is not `mastery_threshold`: that one counts checks in one session and this one judges a person's standing with a concept over every session they have had."
        },
        "decay_window_days": {
          "type": "object",
          "required": [
            "default"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Doc 17 sections 2.3 and 8: how long a mastered concept stays mastered without new evidence, per domain, with `default` for the domains a pack does not name. Computed from `last_evidence_at` when the map is read, so nothing has to run while the app is closed for a concept to go stale."
        },
        "check_templates": {
          "type": "array",
          "description": "Doc 17 sections 4 and 8: the shape of a check at each level. Level 1 recall, 2 explain, 3 apply, 4 discriminate, which is the mapping recorded when the exercise kinds grew rather than a rename of what shipped.",
          "items": {
            "type": "object",
            "required": [
              "level",
              "kinds"
            ],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "kinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "recall",
                    "apply",
                    "contrast",
                    "trace",
                    "explain",
                    "discriminate"
                  ]
                }
              },
              "options": {
                "type": "integer",
                "minimum": 2
              }
            }
          }
        },
        "quality_ranking": {
          "type": "object",
          "description": "Doc 17 section 8: how a pack ranks sources for learning, which is not how it ranks them for answering. A lesson prefers a primary source that explains; an answer prefers the source with authority over the claim, and `source_hierarchy` is that one.",
          "properties": {
            "classes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Source classes best first."
            },
            "issuer_patterns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Issuers a lesson reaches for first."
            },
            "prefer_primary": {
              "type": "boolean"
            }
          }
        },
        "unverified_explanations": {
          "type": "object",
          "description": "Doc 17 section 8: whether the tutor may explain in its own words in the panel, and what it may never explain that way. Finance allows it and never for numbers or obligations, because an unverified figure is the one thing the whole build exists to stop.",
          "required": [
            "allowed"
          ],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "never_for": {
              "type": "array",
              "items": {
                "enum": [
                  "numbers",
                  "obligations",
                  "dates",
                  "definitions"
                ]
              }
            }
          }
        },
        "learning_paths": {
          "type": "array",
          "description": "Doc 17 section 2.1's LearningPath, shipped in a pack or authored. Loading one creates or links the concepts, creates the edges as confirmed, and offers a mission.",
          "items": {
            "type": "object",
            "required": [
              "code",
              "title",
              "concepts"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "title": {
                "type": "string"
              },
              "mission_template": {
                "type": "string"
              },
              "concepts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "concept_term"
                  ],
                  "properties": {
                    "concept_term": {
                      "type": "string"
                    },
                    "prerequisite_terms": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "level_hint": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    }
                  }
                }
              },
              "sources_hint": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "title"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "locator": {
                      "type": "string"
                    },
                    "class": {
                      "$ref": "tessera:entity/common.v1#/$defs/source_class"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "rulings": {
      "type": "array",
      "description": "Accumulated decisions, written by the occupants over time. Pattern 16 team memory, scoped to a pack.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "cites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adopted_at": {
            "$ref": "tessera:entity/common.v1#/$defs/timestamp"
          }
        }
      }
    },
    "reader_extract_first": {
      "type": "array",
      "description": "Doc 07 section A2: what the Reader looks for first is doctrine, not substrate. Finance names figures, dates and article references. A pack that names none leaves this out, and the Reader asks for nothing in particular rather than being handed a guess as though it were doctrine.",
      "items": {
        "type": "string"
      }
    }
  }
}
