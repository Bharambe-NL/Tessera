{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera:output/planner.v1",
  "title": "Planner output",
  "description": "Doc 04 section 5. Harness rules: every retriever id is enabled; sub_questions within budget; depends_on acyclic; must_exclude contains every doctrine must exclude entry, since the Planner may add but never remove; value_policy is cite_only unless the structured retriever is assigned.",
  "type": "object",
  "required": [
    "schema_version",
    "agent_id",
    "run_id",
    "sub_questions",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "run_id": {
      "$ref": "tessera:entity/common.v1#/$defs/ulid"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sub_questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "sq_id",
          "text",
          "purpose",
          "retrievers"
        ],
        "properties": {
          "sq_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "retrievers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "query"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "web",
                    "local",
                    "regulatory",
                    "structured",
                    "boards"
                  ],
                  "description": "boards joined in doc 05 v0.2 section 8.5: the Planner adds it to every sub-question when the profile has memory enabled."
                },
                "query": {
                  "type": "string"
                },
                "filters": {
                  "type": "object",
                  "properties": {
                    "corpus": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "folder": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "date_from": {
                      "oneOf": [
                        {
                          "$ref": "tessera:entity/common.v1#/$defs/timestamp"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "version_ref": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                "max_passages": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "entity_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "must_include",
        "must_exclude",
        "answer_scope",
        "value_policy"
      ],
      "properties": {
        "must_include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer_scope": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence the Verifier checks the answer against, doc 07 section B8.5."
        },
        "audience_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_policy": {
          "enum": [
            "cite_only",
            "cite_or_query"
          ]
        },
        "stale_ancestor_citations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "card_id": {
                "$ref": "tessera:entity/common.v1#/$defs/ulid"
              },
              "ordinal": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "resolved_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "literal",
          "ambiguity"
        ],
        "properties": {
          "literal": {
            "type": "string"
          },
          "concept_id": {
            "oneOf": [
              {
                "$ref": "tessera:entity/common.v1#/$defs/ulid"
              },
              {
                "type": "null"
              }
            ]
          },
          "ambiguity": {
            "enum": [
              "none",
              "multiple",
              "unknown"
            ]
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "passages_total": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
