{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera:output/reader.v1",
  "title": "Reader output",
  "description": "Doc 07 section A5. Harness rules: every value in structured_summary.values must appear in recovered_structure, because the Reader may not read numbers that are not in the picture; injection_suspected true means the harness raises a flag and the Synthesizer never receives that block as content.",
  "type": "object",
  "required": [
    "schema_version",
    "agent_id",
    "run_id",
    "description",
    "recovered_structure",
    "injection_suspected"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "run_id": {
      "$ref": "tessera:entity/common.v1#/$defs/ulid"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "recovered_structure": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "table",
            "diagram",
            "list",
            "text",
            "mixed",
            "unrecognised"
          ]
        },
        "table": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "diagram": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "label"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    }
                  }
                },
                "edges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "from",
                      "to"
                    ],
                    "properties": {
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      },
                      "label": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "text_blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "bbox": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        }
      }
    },
    "structured_summary": {
      "$ref": "tessera:entity/structured-summary.v1"
    },
    "detected_source_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "kind"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "title",
              "article_ref",
              "url",
              "date"
            ]
          }
        }
      }
    },
    "notable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "kind"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "number",
              "risk",
              "missing",
              "inconsistency"
            ]
          }
        }
      }
    },
    "legibility": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "injection_suspected": {
      "type": "boolean"
    }
  }
}
