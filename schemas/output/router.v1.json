{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tessera:output/router.v1",
  "title": "Router output",
  "description": "Doc 03 section 5. The harness enforces on receipt: depth.chosen equals request.depth_override when the override is set; every model_resolution alias exists in the profile policy; every early_flags rule_id exists in the doctrine pack; classification.domain is a pack domain or unknown.",
  "type": "object",
  "required": [
    "schema_version",
    "agent_id",
    "run_id",
    "classification",
    "depth",
    "plan_required",
    "model_resolution"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "run_id": {
      "$ref": "tessera:entity/common.v1#/$defs/ulid"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "question_type",
        "regulatory_stakes",
        "domain",
        "language"
      ],
      "properties": {
        "question_type": {
          "enum": [
            "factual",
            "comparative",
            "procedural",
            "quantitative",
            "regulatory",
            "definitional",
            "exploratory",
            "meta"
          ]
        },
        "domain": {
          "type": "string",
          "description": "BN-036. An observed label from the deterministic keyword pass, `unknown` when it did not fire. Never a judgment the model makes and never a gate on anything downstream."
        },
        "audience_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "needs_current_information": {
          "type": "boolean"
        },
        "needs_internal_documents": {
          "type": "boolean"
        },
        "needs_structured_data": {
          "type": "boolean"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "is_follow_up_of_context": {
          "type": "boolean"
        },
        "regulatory_stakes": {
          "type": "boolean",
          "description": "BN-036. Whether the answer turns on a rule, threshold, date or obligation the reader might act on. Drives depth; retrieval is never gated on classification."
        }
      }
    },
    "depth": {
      "type": "object",
      "required": [
        "chosen",
        "recommended",
        "reason",
        "overridden_by_user"
      ],
      "properties": {
        "chosen": {
          "$ref": "tessera:entity/common.v1#/$defs/depth"
        },
        "recommended": {
          "$ref": "tessera:entity/common.v1#/$defs/depth"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence naming the step of doc 03 section 8.2 that decided."
        },
        "overridden_by_user": {
          "type": "boolean"
        }
      }
    },
    "plan_required": {
      "type": "boolean"
    },
    "visual_hint": {
      "enum": [
        "tree",
        "table",
        "list",
        "steps",
        "figure",
        "image",
        "none"
      ]
    },
    "model_resolution": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Stage to alias. Snapshotted onto the Run at start."
    },
    "early_flags": {
      "type": "array",
      "items": {
        "$ref": "tessera:output/verifier.v1#/$defs/flag"
      }
    },
    "context_notes": {
      "type": "object",
      "properties": {
        "parent_is_stale": {
          "type": "boolean"
        },
        "parent_stale_reason": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "repetition_of_recent": {
          "oneOf": [
            {
              "$ref": "tessera:entity/common.v1#/$defs/ulid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
